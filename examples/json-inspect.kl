// JSON round-trip demo: parse, inspect, and re-render JSON with the
// pure-Klassic std.json module, under the evaluator or any native target:
//
//   klassic examples/json-inspect.kl
//   klassic build examples/json-inspect.kl -o json-inspect
//
// An array's elements are a cons-style enum rather than a list, which is what
// lets the module compile on every target; walking one is a `match` per cell.

import std.json.{parse, stringify}

def countValues(j: Json): Int = j match {
  case JNull => 1
  case JBool(b) => 1
  case JNum(n) => 1
  case JStr(s) => 1
  case JArr(items) => countAll(items, 0)
  case JObj(entries) => countMembers(entries, 0)
}

def countAll(items: JsonValues, acc: Int): Int = items match {
  case ValuesNil => acc
  case ValuesCons(h, t) => countAll(t, acc + countValues(h))
}

def countMembers(entries: JsonMembers, acc: Int): Int = entries match {
  case MembersNil => acc
  case MembersCons(h, t) => h match {
    case Member(key, value) => countMembers(t, acc + countValues(value))
  }
}

val text = "{\"name\": \"klassic\", \"tags\": [\"compiler\", \"adt\"], \"stars\": 230, \"native\": true}"

parse(text) match {
  case Ok(json) => {
    println("parsed OK")
    println("values: " + countValues(json).toString())
    println(stringify(json))
  }
  case Err(message) => println("parse error: " + message)
}

parse("[1, 2") match {
  case Ok(_) => println("unreachable")
  case Err(message) => println(message)
}
