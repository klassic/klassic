// Cross-target fixture: typeclass instance dispatch and string appending.
//
// Every backend must agree with the evaluator here. The interesting part is
// that `show` is declared once and implemented several times -- which
// implementation a call means is decided by the argument's type, so this
// fixture fails loudly on any backend that resolves overloads by declaration
// order instead. The `"..." + value` forms cover appending an Int and a Bool
// to a string, which allocate and so also exercise the collector while a
// live string operand waits.

typeclass Show<'a> where {
  show: ('a) => String
}

instance Show<Int> where {
  def show(x: Int): String = "Int: " + x
}

instance Show<String> where {
  def show(x: String): String = "String: " + x
}

instance Show<Boolean> where {
  def show(x: Boolean): String = "Bool: " + x
}

println(show(42))
println(show("hello"))
println(show(true))

// Appending, including a chain that builds several intermediate strings.
println("n=" + 7)
println("ok=" + false)
println("a" + 1 + "b" + 2 + "c")

// assertResult is the sample programs' assertion: equal values are silent,
// so reaching the end means every comparison held.
assertResult("Int: 1")(show(1))
assertResult("String: s")(show("s"))
assertResult("Bool: true")(show(true))
assertResult(15)(7 + 8)
assertResult("x=3")("x=" + 3)
println("assertions held")

// Dictionary passing: a record whose fields are lambdas, handed to a function
// that calls one of them. Two different dictionaries go through the same
// function, so a backend that specialised on the first would answer the second
// wrongly.
val Show_Int_dict = record { show: (x: Int) => "Int(" + x + ")" }
val Show_Str_dict = record { show: (x: String) => "Str(" + x + ")" }
def showValue(dict: record { show: ('a) => String }, x: 'a): String = dict.show(x)
println(showValue(Show_Int_dict, 42))
println(showValue(Show_Str_dict, "hi"))
println(Show_Int_dict.show(7))
assertResult("Int(1)")(showValue(Show_Int_dict, 1))
assertResult("Str(s)")(showValue(Show_Str_dict, "s"))

// The language's tiny regex: `.*`, a digit run, a single digit, or a literal.
// The pattern comes from a variable here, so a backend that only folds static
// patterns has to do the work at run time.
val digits = "[0-9]+"
println(matches("199", digits))
println(matches("a", digits))
println(matches("7", "[0-9]"))
println(matches("77", "[0-9]"))
println(matches("anything", ".*"))
println(matches("abc", "abc"))
assertResult(true)(matches("2026", digits))
assertResult(false)(matches("", digits))

// A function bound as a value: there is no function value at run time on the
// aarch64 backend, so the name is an alias resolved at each call.
val sub = substring
val up = toUpperCase
println(sub("BAR", 0, 1))
println(up("abc"))
assertResult("B")(sub("BAR", 0, 1))
assertResult("ABC")(up("abc"))
